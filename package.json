{
  "name": "agent-device-protocol",
  "description": "Agent Device Protocol (ADP): an open protocol for AI agents to own and use real devices",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentmessaging/agent-device-protocol.git"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "clients/linux",
    "apps/controller"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --strict --types node --module nodenext --target ES2022 tests/sdk-types.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
