{
  "name": "ai-maestro-device-protocol",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ai-maestro-device-protocol",
      "workspaces": [
        "packages/*",
        "clients/linux",
        "apps/controller"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/controller": {
      "name": "@ai-maestro/device-controller",
      "version": "0.1.0",
      "dependencies": {
        "@ai-maestro/device-sdk": "0.1.0"
      }
    },
    "clients/linux": {
      "name": "@ai-maestro/device-linux",
      "version": "0.1.0",
      "dependencies": {
        "@ai-maestro/device-sdk": "0.1.0"
      }
    },
    "node_modules/@ai-maestro/device-controller": {
      "resolved": "apps/controller",
      "link": true
    },
    "node_modules/@ai-maestro/device-linux": {
      "resolved": "clients/linux",
      "link": true
    },
    "node_modules/@ai-maestro/device-sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "packages/sdk": {
      "name": "@ai-maestro/device-sdk",
      "version": "0.1.0"
    }
  }
}
