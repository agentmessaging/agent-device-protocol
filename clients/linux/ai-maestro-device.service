[Unit]
Description=AI Maestro device bridge

[Service]
Environment=ADP_NODE=/usr/bin/node
EnvironmentFile=%h/.config/ai-maestro-device/service.env
ExecStart=/usr/bin/env ${ADP_NODE} ${ADP_REPO}/clients/linux/cli.mjs serve ${ADP_BIND}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
