# Seeed XIAO ESP32-S3 Sense: 8 MB flash, 8 MB octal PSRAM, camera on the Sense board.
# Use with: idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.xiao-s3-sense" set-target esp32s3
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# A 4 MB app for the wake phrase detector; nvs stays where it was, so the device key survives
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8mb.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Turning the camera on is the owner's local grant for camera.snapshot
CONFIG_ADP_CAMERA=y
# Speech for speaker.play arrives as one message of up to about 1 MB. The ESP-IDF defaults (a 5.7 KB TCP
# window) received 308 KB in 1.6 s; Espressif's throughput settings, with buffers in PSRAM:
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=32
